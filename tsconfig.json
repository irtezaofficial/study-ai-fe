{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable", "ES2022.Error"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "./",
    "paths": {
      "~/*": ["./*"],
      "@mui/styled-engine": ["./src/node_modules/@mui/styled-engine-sc"],
      "@Services/*": ["./src/services/*"],
      "@Assets/*": ["./src/assets/*"],
      "@Components/*": ["./src/components/*"],
      "@Pages/*": ["./src/pages/*"],
      "@Constants/*": ["./src/constants/*"],
      "@Api/*": ["./src/apiService/*"],
      "@Store/*": ["./src/stores/*"],
      "@FormValidations/*": ["./src/formValidations/*"],
      "@ReusableFunctions/*": ["./src/reusableFunctions/*"],
      "@Routes/*": ["./src/routes/*"],
      "@Theme/*": ["./src/theme/*"],
      "@Utils/*": ["./src/utils/*"],
      "@Navigation/*": ["./src/navigation/*"],
      "@Hooks/*": ["./src/hooks/*"]
    },
    "types": ["vite-plugin-svgr/client"]
  },
  "include": ["src", "vite-env.d.ts", "./*.ts", "./*.tsx", "firebase.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
